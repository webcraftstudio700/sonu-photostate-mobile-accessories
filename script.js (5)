let shoppingCart = {};

const cartItemsBox = document.getElementById("cartItems");
const cartCountBox = document.getElementById("cartCount");
const cartTotalBox = document.getElementById("cartTotal");


function updateCart() {

    if (!cartItemsBox) return;

    cartItemsBox.innerHTML = "";

    const productIds = Object.keys(shoppingCart);

    let total = 0;
    let itemCount = 0;

    if (productIds.length === 0) {
        cartItemsBox.innerHTML =
            '<p class="cart-empty">Your cart is empty. Add a product to get started.</p>';
    }

    productIds.forEach(id => {

        const product = shopProducts[id];
        const quantity = shoppingCart[id];

        const subtotal = product.price * quantity;

        total += subtotal;
        itemCount += quantity;

        const item = document.createElement("div");

        item.className = "cart-item";

        const details = document.createElement("div");

        const name = document.createElement("h4");
        name.textContent = product.name;

        const price = document.createElement("p");
        price.className = "cart-item-price";
        price.textContent = `₹${product.price} × ${quantity} = ₹${subtotal}`;

        details.append(name, price);

        const controls = document.createElement("div");
        controls.className = "cart-item-controls";

        const decrease = document.createElement("button");
        decrease.className = "cart-qty-btn";
        decrease.textContent = "−";
        decrease.setAttribute("aria-label", "Decrease quantity");
        decrease.addEventListener("click", () => {
            if (shoppingCart[id] > 1) {
                shoppingCart[id]--;
            } else {
                delete shoppingCart[id];
            }
            updateCart();
        });

        const quantityText = document.createElement("span");
        quantityText.textContent = quantity;

        const increase = document.createElement("button");
        increase.className = "cart-qty-btn";
        increase.textContent = "+";
        increase.setAttribute("aria-label", "Increase quantity");
        increase.addEventListener("click", () => {
            shoppingCart[id]++;
            updateCart();
        });

        const remove = document.createElement("button");
        remove.className = "cart-remove-btn";
        remove.innerHTML = '<i class="fa-solid fa-trash"></i>';
        remove.setAttribute("aria-label", "Remove product");
        remove.addEventListener("click", () => {
            delete shoppingCart[id];
            updateCart();
        });

        controls.append(decrease, quantityText, increase, remove);
        item.append(details, controls);
        cartItemsBox.appendChild(item);

    });

    cartCountBox.textContent =
        `${itemCount} ${itemCount === 1 ? "item" : "items"}`;

    cartTotalBox.textContent = `₹${total}`;
}


/* ADD TO CART */

document.querySelectorAll("[data-add]").forEach(button => {

    button.addEventListener("click", () => {

        const id = button.dataset.add;

        if (!shopProducts[id]) return;

        shoppingCart[id] = (shoppingCart[id] || 0) + 1;

        updateCart();

        const originalText = button.innerHTML;

        button.innerHTML =
            '<i class="fa-solid fa-check"></i> Added';

        setTimeout(() => {
            button.innerHTML = originalText;
        }, 1000);

    });

});


/* WHATSAPP CHECKOUT */

const whatsappOrderButton =
    document.getElementById("whatsappOrder");

if (whatsappOrderButton) {

    whatsappOrderButton.addEventListener("click", () => {

        const productIds = Object.keys(shoppingCart);

        if (productIds.length === 0) {
            alert("Please add at least one product to your cart.");
            return;
        }

        const customerName =
            document.getElementById("customerName").value.trim();

        const customerPhone =
            document.getElementById("customerPhone").value.trim();

        const customerAddress =
            document.getElementById("customerAddress").value.trim();

        if (!customerName || !customerPhone) {
            alert("Please enter your name and mobile number.");
            return;
        }

        const phoneDigits = customerPhone.replace(/\D/g, "");

        if (!/^\d{10}$/.test(phoneDigits)) {
            alert("Please enter a valid 10-digit mobile number.");
            return;
        }

        let total = 0;

        let message =
            "Hello Sonu Photostate & Mobile Accessories!\n\n" +
            "I would like to place an order:\n\n";

        productIds.forEach((id, index) => {

            const product = shopProducts[id];
            const quantity = shoppingCart[id];
            const subtotal = product.price * quantity;

            total += subtotal;

            message +=
                `${index + 1}. ${product.name}\n` +
                `Quantity: ${quantity}\n` +
                `Price: ₹${product.price}\n` +
                `Subtotal: ₹${subtotal}\n\n`;

        });

        message +=
            `Total Amount: ₹${total}\n\n` +
            `Customer Name: ${customerName}\n` +
            `Mobile Number: ${customerPhone}\n`;

        if (customerAddress) {
            message += `Address / Pickup Details: ${customerAddress}\n`;
        }

        message +=
            "\nPlease confirm product availability and order details. Thank you!";

        const whatsappURL =
            "https://wa.me/919541671094?text=" +
            encodeURIComponent(message);

        window.open(whatsappURL, "_blank");

    });

}

